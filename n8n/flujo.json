    {
      "parameters": {
        "jsCode": "const filas = $input.all()\n  .map(i => i.json)\n  .filter(f => f.categoria);\n\nif (filas.length === 0) {\n  return [{ json: { text: 'No hay gastos registrados este mes.' } }];\n}\n\nconst total = filas.reduce((s, f) => s + Number(f.total), 0);\nconst lineas = filas.map(f => `• ${f.categoria}: $${Number(f.total).toFixed(2)}`);\n\nconst text = `📊 Resumen del mes\\n${lineas.join('\\n')}\\n\\n💰 Total: $${total.toFixed(2)}`;\n\nreturn [{ json: { text } }];"
      },
