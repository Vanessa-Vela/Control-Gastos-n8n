    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.nombre AS categoria,\n       SUM(g.monto) AS total\nFROM gastos g\nJOIN categorias c ON c.id = g.categoria_id\nWHERE g.fecha_gasto >= date_trunc('month', now() AT TIME ZONE 'America/Guayaquil')\n                       AT TIME ZONE 'America/Guayaquil'\nGROUP BY c.nombre\nORDER BY total DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
