    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nuevo AS (\n  INSERT INTO gastos (categoria_id, monto, descripcion)\n  SELECT id, $1::numeric, $2\n  FROM categorias\n  WHERE nombre = $3\n  RETURNING monto, descripcion, categoria_id\n)\nSELECT n.monto, n.descripcion, c.nombre AS categoria\nFROM nuevo n\nJOIN categorias c ON c.id = n.categoria_id;",
        "options": {
          "queryReplacement": "={{ [$json.monto, $json.descripcion, $json.categoria] }}"
        }
      },
