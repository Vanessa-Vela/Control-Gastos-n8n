        "messages": {
          "values": [
            {
              "content": "=Eres un extractor de datos. Recibes un mensaje de gasto en español y\nrespondes SOLO con un JSON válido, sin texto adicional ni markdown:\n{\"monto\": number, \"descripcion\": string, \"categoria\": string}\nCategorías permitidas: Comida, Transporte, Estudios, Ocio, Otros.\nSi el mensaje no describe un gasto, responde: {\"error\": \"no_es_gasto\"}\n\nMensaje: {{ $('Telegram Trigger').item.json.message.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        416,
        -304
      ],
      "id": "c85725c1-e573-4826-8501-028670976fb8",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "gmZlOKwpHk64H8BH",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.content?.parts?.[0]?.text ?? $json.text ?? $json.output ?? '';\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst CATEGORIAS = ['Comida', 'Transporte', 'Estudios', 'Ocio', 'Otros'];\n\nconst fail = (motivo) => ({ json: { ok: false, chat_id: chatId, motivo } });\n\nlet data;\ntry {\n  data = JSON.parse(String(raw).replace(/```json|```/g, '').trim());\n} catch (e) {\n  return fail('La IA no devolvió un JSON válido');\n}\n\nif (!data || typeof data !== 'object') return fail('Respuesta inesperada de la IA');\nif (data.error) return fail('No parece un gasto');\nlet monto = typeof data.monto === 'string'\n  ? parseFloat(data.monto.replace(/[^0-9.,-]/g, '').replace(',', '.'))\n  : Number(data.monto);\n\nif (!Number.isFinite(monto) || monto <= 0 || monto > 100000) {\n  return fail('Monto inválido');\n}\nmonto = Math.round(monto * 100) / 100;\n\nconst texto = $('Telegram Trigger').item.json.message.text ?? '';\n\n// Rechaza si el mensaje original trae un número con signo negativo\nif (/(^|\\s)-\\s*\\d/.test(texto)) return fail('Monto negativo en el mensaje');\n\n// El monto que devolvió la IA debe aparecer realmente en el mensaje\nconst numeros = (texto.match(/\\d+(?:[.,]\\d+)?/g) ?? [])\n  .map(n => parseFloat(n.replace(',', '.')));\nif (!numeros.some(n => Math.abs(n - monto) < 0.005)) {\n  return fail('El monto no aparece en el mensaje');\n}\n\nconst descripcion = String(data.descripcion ?? '').trim().slice(0, 200);\nif (!descripcion) return fail('Falta la descripción');\n\nconst categoria = CATEGORIAS.includes(data.categoria) ? data.categoria : 'Otros';\n\nreturn { json: { ok: true, chat_id: chatId, monto, descripcion, categoria } };"
      },
